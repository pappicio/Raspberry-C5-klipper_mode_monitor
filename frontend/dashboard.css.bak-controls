.oc-launch {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 99990;
    border: 1px solid #64748b;
    border-radius: 9px;
    padding: 11px 16px;
    background: #202b3b;
    color: #fff;
    font: 600 13px sans-serif;
    cursor: pointer;
    box-shadow: 0 3px 14px #0005;
}

.oc-panel {
    display: none;
    position: fixed;
    z-index: 99999;
    top: 0;
    right: 0;
    width: min(440px, 94vw);
    height: 100vh;
    overflow-y: auto;
    background: var(--oc-bg, #18212e);
    color: var(--oc-fg, #e5e7eb);
    box-shadow: -5px 0 24px #0006;
    font: 13px/1.45 sans-serif;
}

.oc-panel.oc-visible {
    display: block;
}

.oc-header {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 17px 18px;
    background: #202b3b;
    border-bottom: 1px solid #ffffff20;
    font-size: 15px;
}

.oc-close {
    border: 0;
    background: transparent;
    color: white;
    font-size: 27px;
    cursor: pointer;
}

.oc-content {
    padding: 12px 18px 24px;
}

.oc-section {
    margin: 8px 0 18px;
}

.oc-section h3 {
    margin: 0 0 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid #ffffff25;
    color: #93c5fd;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
}

.oc-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 5px 0;
    border-bottom: 1px solid #ffffff0c;
}

.oc-label {
    color: #aebaca;
    overflow-wrap: anywhere;
}

.oc-value {
    text-align: right;
    font-weight: 600;
    overflow-wrap: anywhere;
}

.oc-good { color: #4ade80; }
.oc-bad { color: #f87171; }
.oc-warning { color: #fbbf24; }

.oc-loading,
.oc-error {
    padding: 15px 0;
}

.oc-error { color: #f87171; }

.oc-footer {
    margin-top: 20px;
    color: #94a3b8;
    font-size: 11px;
    text-align: center;
}


/* Community Projects */
.oc-project-toolbar {
    display: flex;
    justify-content: flex-end;
    margin: 8px 0;
}

.oc-project-check {
    border: 1px solid #64748b;
    border-radius: 6px;
    padding: 6px 10px;
    background: #26364a;
    color: #e5e7eb;
    cursor: pointer;
    font: inherit;
}

.oc-project-check:disabled {
    opacity: .6;
    cursor: wait;
}

.oc-project-card {
    margin: 10px 0;
    padding: 12px;
    border: 1px solid #ffffff20;
    border-radius: 8px;
    background: #ffffff08;
}

.oc-project-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
}

.oc-project-name {
    font-size: 14px;
    overflow-wrap: anywhere;
}

.oc-project-status {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 700;
}

.oc-project-description {
    margin: 7px 0;
    color: #cbd5e1;
}

.oc-project-meta,
.oc-project-commits {
    margin-top: 7px;
    color: #94a3b8;
    font-size: 11px;
    overflow-wrap: anywhere;
}

.oc-project-components {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 9px;
}

.oc-project-component {
    padding: 3px 7px;
    border-radius: 5px;
    background: #334155;
    color: #e2e8f0;
    font-size: 11px;
}

.oc-project-link {
    display: inline-block;
    margin-top: 10px;
    color: #93c5fd;
    text-decoration: none;
}

.oc-project-link:hover {
    text-decoration: underline;
}

.oc-project-warning {
    margin: 7px 0 0;
    color: #fbbf24;
    font-size: 11px;
}

.oc-project-empty {
    color: #94a3b8;
    font-size: 12px;
}
