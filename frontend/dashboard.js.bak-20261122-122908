(() => {
    if (window.openCreatorDashboardLoaded) return;
    window.openCreatorDashboardLoaded = true;

    const API = new URL("/api/dashboard", document.currentScript.src).href;
    const PROJECTS_API = new URL("/api/custom-projects", document.currentScript.src).href;
    const SYNC_API = new URL("/api/synchronization", document.currentScript.src).href;
    let panel;
    let refreshTimer;

    const el = (tag, cls, value) => {
        const node = document.createElement(tag);
        if (cls) node.className = cls;
        if (value !== undefined) node.textContent = value;
        return node;
    };

    const section = (parent, title) => {
        const block = el("section", "oc-section");
        block.appendChild(el("h3", "", title));
        parent.appendChild(block);
        return block;
    };

    const row = (parent, label, value, state) => {
        const line = el("div", "oc-row");
        line.appendChild(el("span", "oc-label", label));
        const result = el("span", "oc-value", value);
        if (state) result.classList.add("oc-" + state);
        line.appendChild(result);
        parent.appendChild(line);
    };

    const temperature = value =>
        value && Number.isFinite(value.temperature)
            ? `${value.temperature.toFixed(1)} °C`
            : "Unavailable";

    function createPanel() {
        const button = el("button", "oc-launch", "OpenCreator");
        button.type = "button";
        button.addEventListener("click", () => {
            panel.classList.toggle("oc-visible");
            if (panel.classList.contains("oc-visible")) refresh();
        });
        document.body.appendChild(button);

        panel = el("aside", "oc-panel");
        const header = el("header", "oc-header");
        header.appendChild(el("strong", "", "OpenCreator Dashboard"));

        const close = el("button", "oc-close", "×");
        close.type = "button";
        close.setAttribute("aria-label", "Close dashboard");
        close.addEventListener("click", () =>
            panel.classList.remove("oc-visible")
        );

        header.appendChild(close);
        panel.appendChild(header);

        const content = el("div", "oc-content");
        content.id = "oc-dashboard-content";
        content.appendChild(el("p", "oc-loading", "Loading dashboard…"));
        panel.appendChild(content);

        document.body.appendChild(panel);
    }


    function renderProjects(parent, data) {
        const previous = document.getElementById("oc-community-projects");
        if (previous) previous.remove();

        const block = section(parent, "Community Projects");
        block.id = "oc-community-projects";

        const toolbar = el("div", "oc-project-toolbar");
        const check = el("button", "oc-project-check", "Check GitHub");
        check.type = "button";
        check.addEventListener("click", async () => {
            check.disabled = true;
            check.textContent = "Checking…";

            try {
                const response = await fetch(
                    PROJECTS_API + "?refresh=1",
                    { cache: "no-store" }
                );
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                renderProjects(parent, await response.json());
            } catch (error) {
                check.disabled = false;
                check.textContent = "Retry check";
                message.textContent = `GitHub check failed: ${error.message}`;
            }
        });
        toolbar.appendChild(check);
        block.appendChild(toolbar);

        const message = el("p", "oc-project-empty", "");
        block.appendChild(message);

        if (data?.error) {
            message.textContent = data.error;
            return;
        }

        const projects = data?.projects || [];

        if (!projects.length) {
            message.textContent = "No compatible projects detected.";
            return;
        }

        message.textContent = `${projects.length} compatible project(s) detected.`;

        for (const project of projects) {
            const card = el("article", "oc-project-card");

            const heading = el("div", "oc-project-heading");
            heading.appendChild(el("strong", "oc-project-name", project.name || project.id));

            let status = "GitHub unavailable";
            let statusClass = "oc-bad";

            if (project.remote_reachable) {
                if (project.dirty) {
                    status = "Local changes";
                    statusClass = "oc-warning";
                } else if (project.updates_available > 0) {
                    status = `${project.updates_available} update(s)`;
                    statusClass = "oc-warning";
                } else {
                    status = "Up to date";
                    statusClass = "oc-good";
                }
            }

            heading.appendChild(el("span", `oc-project-status ${statusClass}`, status));
            card.appendChild(heading);

            if (project.description) {
                card.appendChild(el("p", "oc-project-description", project.description));
            }

            const details = [];
            if (project.author) details.push(`By ${project.author}`);
            if (project.repository) details.push(project.repository);
            if (project.branch) details.push(`Branch: ${project.branch}`);

            card.appendChild(el("div", "oc-project-meta", details.join(" · ")));

            if (Array.isArray(project.components) && project.components.length) {
                const components = el("div", "oc-project-components");
                for (const component of project.components) {
                    components.appendChild(
                        el("span", "oc-project-component", component)
                    );
                }
                card.appendChild(components);
            }

            const commits = el("div", "oc-project-commits");
            commits.textContent =
                `Local: ${(project.local_commit || "Unknown").slice(0, 7)}`
                + ` · GitHub: ${(project.remote_commit || "Unavailable").slice(0, 7)}`;
            card.appendChild(commits);

            if (project.local_ahead > 0) {
                card.appendChild(el(
                    "p", "oc-project-warning",
                    `${project.local_ahead} local commit(s) not present on GitHub`
                ));
            }

            if (project.dirty) {
                card.appendChild(el(
                    "p", "oc-project-warning",
                    "The local repository contains uncommitted changes."
                ));
            }

            if (project.error) {
                card.appendChild(el(
                    "p", "oc-project-warning",
                    `GitHub: ${project.error}`
                ));
            }

            if (
                typeof project.repository === "string"
                && /^https:\/\/github\.com\/[^/]+\/[^/]+\/?$/.test(project.repository)
            ) {
                const link = el("a", "oc-project-link", "Open GitHub repository ↗");
                link.href = project.repository;
                link.target = "_blank";
                link.rel = "noopener noreferrer";
                card.appendChild(link);
            }

            block.appendChild(card);
        }
    }

    function renderControls(parent, data) {
        const controls = section(parent, "Controls");
        const actions = el("div", "oc-control-actions");

        if (data.soc.mode === "tunneled") {
            const goSoc = el("button", "oc-control-button", "Go SoC");
            goSoc.type = "button";
            goSoc.addEventListener("click", () => {
                if (window.confirm("Switch the Creator 5 to SoC mode?")) {
                    window.open("/api/go-soc", "_blank", "noopener");
                }
            });
            actions.appendChild(goSoc);
        }

        const currentScreen = String(data.creator.screen || "").toLowerCase();

        for (const screen of ["grumpy", "helix"]) {
            const label = screen === "grumpy"
                ? "Switch to Grumpy"
                : "Switch to Helix";

            const button = el("button", "oc-control-button", label);
            button.type = "button";
            button.disabled = currentScreen === screen;

            button.addEventListener("click", async () => {
                if (!window.confirm(`Switch the screen to ${screen}?`)) {
                    return;
                }

                button.disabled = true;
                try {
                    const response = await fetch(`/api/screen/${screen}`, {
                        method: "POST",
                        cache: "no-store"
                    });
                    const result = await response.json();

                    if (!response.ok || !result.success) {
                        throw new Error(result.error || `HTTP ${response.status}`);
                    }

                    await refresh();
                } catch (error) {
                    window.alert(`Screen switch failed: ${error.message}`);
                    button.disabled = false;
                }
            });

            actions.appendChild(button);
        }

        controls.appendChild(actions);
    }


    function parseToolchanges(value) {
        if (typeof value !== "string") return null;
        const result = {};
        for (const line of value.split(/\r?\n/)) {
            const match = line.match(/^\s*(Total|T[0-3])\s*:\s*(\d+)\s*$/i);
            if (match) result[match[1].toUpperCase()] = Number(match[2]);
        }
        return Object.keys(result).length ? result : null;
    }

    function decodeFile(info) {
        if (!info || info.exists !== true || typeof info.data !== "string") return null;
        try {
            const binary = atob(info.data);
            return Uint8Array.from(binary, char => char.charCodeAt(0));
        } catch {
            return null;
        }
    }

    function fileDate(info) {
        if (!Number.isFinite(info?.mtime_ns)) return "Unknown";
        return new Date(info.mtime_ns / 1e6).toLocaleString();
    }

    function calibrationDetails(filename, info) {
        const bytes = decodeFile(info);
        if (!bytes) return "File unavailable";
        const size = `${bytes.length.toLocaleString()} bytes`;
        try {
            let raw = new TextDecoder().decode(bytes);
            raw = raw.replace(/\/\*[\s\S]*?\*\//g, "");
            const data = JSON.parse(raw);

            if (filename === "extruder.json") {
                const offsets = data.offsets || {};
                const tools = ["t0", "t1", "t2", "t3"]
                    .map(key => {
                        const value = offsets[key];
                        return value
                            ? `${key.toUpperCase()}: X ${Number(value.x).toFixed(3)}, Y ${Number(value.y).toFixed(3)}, Z ${Number(value.z).toFixed(3)}`
                            : `${key.toUpperCase()}: unavailable`;
                    });
                return [
                    size,
                    `Focal offset: ${data.focal_offset ?? "Unknown"}`,
                    `Pixel distance: ${data.pixel_distance ?? "Unknown"}`,
                    ...tools
                ].join(" · ");
            }

            return [
                size,
                ...Object.entries(data).map(([key, value]) => `${key}: ${value}`)
            ].join(" · ");
        } catch {
            return size + " · Unreadable calibration data";
        }
    }

    function renderSyncStatus(parent, status) {
        const state = status === "Synced" ? "good"
            : status === "Different" || status === "Conflict" ? "warning"
            : "bad";
        row(parent, "Sync status", status, state);
    }

    function renderSyncButton(parent, item, status, mode) {
        if (status !== "Different" || !mode) return;

        const button = el("button", "oc-sync-button", "Sync");
        button.type = "button";
        button.addEventListener("click", async () => {
            const direction = mode === "soc"
                ? "External Host → Creator 5"
                : "Creator 5 → External Host";

            if (!window.confirm(`Synchronize ${item}?\nDirection: ${direction}`)) return;

            button.disabled = true;
            button.textContent = "Syncing…";

            try {
                const response = await fetch(`${SYNC_API}/${item}`, {
                    method: "POST",
                    cache: "no-store"
                });
                const result = await response.json();
                if (!response.ok || result.success === false) {
                    throw new Error(result.error || `HTTP ${response.status}`);
                }
                await refresh();
            } catch (error) {
                window.alert(`Synchronization failed: ${error.message}`);
                button.disabled = false;
                button.textContent = "Retry Sync";
            }
        });
        parent.appendChild(button);
    }

    function renderSynchronization(parent, data) {
        const block = section(parent, "Data Synchronization");
        const mode = data?.mode;

        row(block, "Automatic sync", "On mode change");
        row(block, "Current direction",
            data?.sync_direction || "Unavailable",
            data?.sync_direction ? "good" : "bad");

        const external = data?.external_host || {};
        const creator = data?.creator || {};
        const creatorReachable = !!creator &&
            !creator._error && creator.success !== false;

        function itemCard(title) {
            const card = el("article", "oc-sync-card");
            card.appendChild(el("h4", "", title));
            return card;
        }

        function unavailable(card, reason) {
            renderSyncStatus(card, "Unavailable");
            card.appendChild(el("p", "oc-sync-note", reason));
        }

        function showComparison(card, status, item) {
            renderSyncStatus(card, status);
            renderSyncButton(card, item, status, mode);
        }

        function formatToolchanges(parsed) {
            return ["TOTAL", "T0", "T1", "T2", "T3"]
                .map(key => `${key}: ${parsed[key] ?? "—"}`)
                .join(" · ");
        }

        // Toolchanges
        {
            const card = itemCard("Toolchanges");
            const local = external.toolchanges;
            const remote = creator.toolchanges;
            const a = parseToolchanges(local);
            const b = creatorReachable ? parseToolchanges(remote) : null;

            if (a) row(card, "External Host", formatToolchanges(a));
            else row(card, "External Host", "Unavailable", "bad");

            if (b) row(card, "Creator 5", formatToolchanges(b));
            else row(card, "Creator 5", "Unavailable", "bad");

            if (a && b) {
                const status = local.trim() === remote.trim()
                    ? "Synced" : "Different";
                showComparison(card, status, "toolchanges");
            } else {
                unavailable(card, "Comparison requires valid data from both devices.");
            }
            block.appendChild(card);
        }

        // Nozzle hours
        {
            const card = itemCard("Nozzle Hours");
            const a = external.nozzle_hours;
            const b = creatorReachable ? creator.nozzle_hours : null;
            const keys = [0, 1, 2, 3].map(i => `nozzle_seconds_t${i}`);

            const validA = a && !a._error && a.success !== false &&
                keys.every(key => Number.isFinite(a[key]));
            const validB = b && !b._error && b.success !== false &&
                keys.every(key => Number.isFinite(b[key]));

            for (let i = 0; i < 4; i++) {
                const key = keys[i];
                if (validA) {
                    row(card, `T${i} · External Host`,
                        `${(a[key] / 3600).toFixed(2)} h`);
                }
                if (validB) {
                    row(card, `T${i} · Creator 5`,
                        `${(b[key] / 3600).toFixed(2)} h`);
                }
            }

            if (!validA) row(card, "External Host", "Unavailable", "bad");
            if (!validB) row(card, "Creator 5", "Unavailable", "bad");

            if (validA && validB) {
                const equal = keys.every(key => a[key] === b[key]);
                showComparison(card, equal ? "Synced" : "Different", "nozzle_hours");
            } else {
                unavailable(card, "Comparison requires valid data from both devices.");
            }
            block.appendChild(card);
        }

        // Calibration files
        const localFirmware = external.firmware_res;
        const remoteFirmware = creatorReachable ? creator.firmware_res : null;

        const localFiles = localFirmware && !localFirmware._error &&
            localFirmware.success !== false ? localFirmware.files : null;
        const remoteFiles = remoteFirmware && !remoteFirmware._error &&
            remoteFirmware.success !== false ? remoteFirmware.files : null;

        for (const [filename, item] of [
            ["extruder.json", "extruder"],
            ["zoffset.json", "zoffset"]
        ]) {
            const card = itemCard(
                filename === "extruder.json"
                    ? "Extruder Calibration" : "Z Offset Calibration"
            );

            const a = localFiles?.[filename];
            const b = remoteFiles?.[filename];
            const validA = !!a && typeof a.exists === "boolean";
            const validB = !!b && typeof b.exists === "boolean";

            if (validA) {
                row(card, "External Host",
                    a.exists ? `Present · ${fileDate(a)}` : "Missing");
                if (a.exists) {
                    row(card, "External Host data", calibrationDetails(filename, a));
                }
            } else {
                row(card, "External Host", "Unavailable", "bad");
            }

            if (validB) {
                row(card, "Creator 5",
                    b.exists ? `Present · ${fileDate(b)}` : "Missing");
                if (b.exists) {
                    row(card, "Creator 5 data", calibrationDetails(filename, b));
                }
            } else {
                row(card, "Creator 5", "Unavailable", "bad");
            }

            if (validA && validB) {
                let status;

                if (!a.exists && !b.exists) {
                    status = "Synced";
                } else if (a.exists !== b.exists) {
                    status = "Different";
                } else {
                    const leftBytes = decodeFile(a);
                    const rightBytes = decodeFile(b);

                    if (!leftBytes || !rightBytes) {
                        status = "Unavailable";
                    } else {
                        const equal = leftBytes.length === rightBytes.length &&
                            leftBytes.every((value, index) =>
                                value === rightBytes[index]
                            );

                        status = equal ? "Synced"
                            : a.mtime_ns === b.mtime_ns ? "Conflict"
                            : "Different";
                    }
                }

                showComparison(card, status, item);

                if (status === "Conflict") {
                    card.appendChild(el(
                        "p", "oc-sync-note",
                        "Different contents with identical timestamps. Manual review required."
                    ));
                }
            } else {
                unavailable(card, "Comparison requires calibration metadata from both devices.");
            }

            block.appendChild(card);
        }

        if (!creatorReachable) {
            block.appendChild(el(
                "p", "oc-sync-note",
                `Creator 5 synchronization API unavailable: ${creator._error || "No valid response"}`
            ));
        }
    }

    function render(data, projectData, syncData) {
        const content = document.getElementById("oc-dashboard-content");
        content.replaceChildren();

        const printer = section(content, "Printer");
        row(printer, "Klipper", data.printer.connected
            ? data.printer.state : "Disconnected",
            data.printer.connected ? "good" : "bad");
        row(printer, "Print state",
            data.printer.print?.state || "Unknown");
        row(printer, "Creator 5 API",
            data.creator.reachable ? "Online" : "Offline",
            data.creator.reachable ? "good" : "bad");
        row(printer, "SoC mode",
            data.soc.mode || "Unavailable",
            data.soc.mode ? "good" : "bad");
        row(printer, "Screen",
            data.creator.screen || "Unknown");

        renderControls(printer, data);
        renderSynchronization(content, syncData);

        const temps = section(content, "Temperatures");
        row(
            temps,
            `External Host (${data.external_host_name || "Unknown"})`,
            temperature(data.temperatures.external_host)
        );
        row(temps, "Mainboard", temperature(data.temperatures.mainboard));
        row(temps, "Toolhead", temperature(data.temperatures.toolhead));
        row(temps, "Nozzle", temperature(data.temperatures.nozzle));
        row(temps, "Bed", temperature(data.temperatures.bed));

        const mcus = section(content, "MCU boards");
        for (const [name, info] of Object.entries(data.mcus)) {
            row(mcus, name.replace("mcu ", "").toUpperCase(),
                info.connected ? (info.chip || "Connected") : "Unavailable",
                info.connected ? "good" : "bad");
        }

        renderProjects(content, projectData);

        content.appendChild(el(
            "div", "oc-footer",
            "Local dashboard · Auto-refresh every 5 seconds"
        ));
    }

    async function refresh() {
        const content = document.getElementById("oc-dashboard-content");
        try {
            const [response, projectsResponse, syncResponse] = await Promise.all([
                fetch(API, { cache: "no-store" }),
                fetch(PROJECTS_API, { cache: "no-store" }),
                fetch(SYNC_API, { cache: "no-store" })
            ]);
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            let projects = { projects: [], error: null };
            if (projectsResponse.ok) {
                projects = await projectsResponse.json();
            } else {
                projects.error = `Projects API HTTP ${projectsResponse.status}`;
            }
            let syncData = {};
            if (syncResponse.ok) syncData = await syncResponse.json();
            else syncData = { creator: { _error: `HTTP ${syncResponse.status}` } };
            render(data, projects, syncData);
        } catch (error) {
            content.replaceChildren(
                el("p", "oc-error", `Dashboard connection error: ${error.message}`)
            );
        }
    }

    createPanel();
    refresh();
    refreshTimer = window.setInterval(refresh, 5000);
})();
